#!/bin/sh
set -e
. "$toolkit/tools.sh"

maximum_lines=$(setting checks.file-length.max-lines)

echo "pre-commit: file length (max $maximum_lines lines)"
echo "pre-commit: follow SRP - split a file that grew past one job"

source_files=$(
    sources=$(sources_and_tests "$@")
    python_files_in $sources
    typescript_files_in $sources
    php_files_in $sources
)
checked_files=$(printf '%s\n' "$source_files" | without_whitelisted)

overlong_files=$(printf '%s\n' "$checked_files" | grep -a . \
    | while IFS= read -r source_file; do
        line_count=$(awk 'END {print NR}' < "$source_file")

        if [ "$line_count" -gt "$maximum_lines" ]; then
            printf '%s (%s lines)\n' "$source_file" "$line_count"
        fi
    done | within_scope)

fail_on_findings "$overlong_files" "over $maximum_lines lines:"
