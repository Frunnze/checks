#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: typescript dependencies (no known vulnerability)"
echo "checks: stay secure by default - upgrade rather than accept it"

require_binary "$node_binary" node

advisory_filter="$(dirname "$0")/unaccepted_advisories.js"

for source_directory in "$@"; do
    package=$(package_of "$source_directory")

    if audit_report=$(npm audit --prefix "$package" --json 2> /dev/null)
    then
        continue
    fi

    if printf '%s\n' "$audit_report" | grep -q '"vulnerabilities"'; then
        findings=$(printf '%s\n' "$audit_report" \
            | "$node_binary" "$advisory_filter" $(whitelist_entries))

        fail_on_findings "$findings" \
            "a package in $package has a known vulnerability - run npm" \
            "audit fix, pin the fixed version through overrides, or add" \
            "the advisory id to [checks.vulnerable-deps] whitelist:"
        continue
    fi

    if printf '%s\n' "$audit_report" | grep -qE "$unreachable_registry"; then
        echo "checks: npm registry unreachable - skipping the" >&2
        echo "checks: vulnerability scan of $package" >&2
        continue
    fi

    echo "checks: npm audit failed before it could scan $package:" >&2
    printf '%s\n' "$audit_report" >&2
    exit 1
done
