#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: typescript dependencies (declare what you import, drop"
echo "checks: what you don't)"

require_binary "$node_tools/knip" knip

for source_directory in "$@"; do
    package=$(package_of "$source_directory")
    require_node_modules "$package"

    if ! (cd "$package" && "$node_tools/knip" \
        --include dependencies,unlisted,binaries,unresolved); then
        echo "checks: $package/package.json disagrees with the" >&2
        echo "checks: imports - drop the unused dependency, declare" >&2
        echo "checks: the imported one, or configure" >&2
        echo "checks: ignoreDependencies in $package/knip.json" >&2
        exit 1
    fi
done
