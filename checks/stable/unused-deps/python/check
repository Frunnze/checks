#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: python dependencies (declare what you import, drop"
echo "checks: what you don't)"

require_binary "$python_tools/deptry" deptry

installed_packages=$(installed_python_packages)

for source_directory in "$@"; do
    package=$(package_of "$source_directory")

    if ! (cd "$package" && PYTHONPATH="$installed_packages" \
        "$python_tools/deptry" "$(basename "$source_directory")" \
        --experimental-namespace-package); then
        echo "checks: the declared dependencies of $package" >&2
        echo "checks: disagree with its imports - drop the unused," >&2
        echo "checks: declare the imported, or configure" >&2
        echo "checks: [tool.deptry] in $package/pyproject.toml" >&2
        exit 1
    fi
done
