#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "pre-commit: python dependencies (declare what you import, drop"
echo "pre-commit: what you don't)"

require_binary "$python_tools/deptry" deptry

installed_packages=$(installed_python_packages)

for source_directory in "$@"; do
    package=$(package_of "$source_directory")

    if ! (cd "$package" && PYTHONPATH="$installed_packages" \
        "$python_tools/deptry" src --experimental-namespace-package); then
        echo "pre-commit: the declared dependencies of $package" >&2
        echo "pre-commit: disagree with its imports - drop the unused," >&2
        echo "pre-commit: declare the imported, or configure" >&2
        echo "pre-commit: [tool.deptry] in $package/pyproject.toml" >&2
        exit 1
    fi
done
