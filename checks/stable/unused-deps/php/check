#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: php dependencies (declare what you use, drop what you"
echo "checks: don't)"

require_command composer "brew install composer"
require_binary "$php_tools/composer-dependency-analyser" \
    composer-dependency-analyser

generated_rules=$(mktemp -d)
trap 'rm -rf "$generated_rules"' EXIT

for source_directory in "$@"; do
    package=$(package_of "$source_directory")
    rules="$generated_rules/composer-dependency-analyser.php"
    generated_configuration composer-dependency-analyser "$package" \
        > "$rules"

    if ! "$composer_binary" validate --strict --no-check-publish -q \
        --working-dir="$package"; then
        echo "checks: $package/composer.json or composer.lock is" >&2
        echo "checks: invalid" >&2
        exit 1
    fi

    if ! (cd "$package" \
        && "$php_tools/composer-dependency-analyser" --config "$rules"); then
        echo "checks: $package/composer.json disagrees with the" >&2
        echo "checks: code - drop the unused package, declare the" >&2
        echo "checks: used one, or move a dev package out of" >&2
        echo "checks: production code" >&2
        exit 1
    fi
done
