#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: dart dependencies (declare what you import, drop what"
echo "checks: you don't)"

require_command dart "brew install dart-sdk"
require_binary "$dart_tools/dependency_validator" dependency_validator

for package in $(packages_of "$@"); do
    if ! (cd "$package" && PUB_CACHE="$dart_tool_cache" \
        "$dart_tools/dependency_validator"); then
        echo "checks: $package/pubspec.yaml disagrees with the" >&2
        echo "checks: imports - drop the unused package, declare the" >&2
        echo "checks: imported one, or configure" >&2
        echo "checks: $package/dart_dependency_validator.yaml" >&2
        exit 1
    fi
done
