#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: secrets (nothing private leaves the machine)"
echo "checks: separate config from code - keep secrets out of git"

require_command gitleaks "brew install gitleaks"

ignored_fingerprints=$(mktemp)
trap 'rm -f "$ignored_fingerprints"' EXIT
whitelist_entries > "$ignored_fingerprints"

scanned_history=--staged

if [ "$hook_stage" = pre-push ]; then
    scanned_history="--log-opts=HEAD --not --remotes"
fi

if [ "$hook_stage" = ci ]; then
    scanned_history=--log-opts=--all
fi

if ! gitleaks git "$scanned_history" --no-banner --redact \
    --gitleaks-ignore-path "$ignored_fingerprints" "$project_root"; then
    echo "checks: a secret is staged - remove it, rotate the" >&2
    echo "checks: credential, or add its fingerprint to" >&2
    echo "checks: [checks.secrets] whitelist in checks.toml" >&2
    exit 1
fi
