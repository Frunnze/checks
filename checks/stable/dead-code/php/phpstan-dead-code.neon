includes:
	- ../../../../vendor/shipmonk/dead-code-detector/rules.neon

parameters:
	level: 0
	customRulesetUsed: true
	shipmonkDeadCode:
		detect:
			deadMethods: true
			deadConstants: true
			deadEnumCases: true
			deadProperties:
				neverRead: true
				neverWritten: true
		reportTransitivelyDeadMethodAsSeparateError: true
