#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: dead code in typescript (delete what nothing reaches)"
echo "checks: follow YAGNI - delete what nothing reaches, do not keep it"

require_binary "$node_tools/knip" knip

for source_directory in "$@"; do
    package=$(package_of "$source_directory")
    require_node_modules "$package"

    if ! (cd "$package" && "$node_tools/knip" \
        --include files,exports,types,duplicates); then
        echo "checks: nothing reaches this code in $package -" >&2
        echo "checks: delete it, or name the entry point in" >&2
        echo "checks: $package/knip.json when the runtime loads it" >&2
        exit 1
    fi
done
