#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: linters in python (ruff, pylint)"
echo "checks: write for the reader - code is read far more than written"

require_binary "$python_tools/ruff" ruff
require_binary "$python_tools/pylint" pylint

default_ruff_rules="$(dirname "$0")/ruff.toml"
ruff_overrides=$(setting checks.linters.ruff)
ignored_ruff_rules=$(whitelisted_rules_for ruff | paste -sd, -)
pylint_rules=$(grep -v -x -F -e "$(whitelisted_rules_for pylint)" \
    "$(dirname "$0")/pylint-rules.txt" | paste -sd, -)

run_ruff() {
    source_directory=$1

    set -- check --config "$default_ruff_rules"

    while IFS= read -r ruff_override; do
        if [ -n "$ruff_override" ]; then
            set -- "$@" --config "$ruff_override"
        fi
    done <<OVERRIDES
$ruff_overrides
OVERRIDES

    if [ -n "$ignored_ruff_rules" ]; then
        set -- "$@" --ignore "$ignored_ruff_rules"
    fi

    "$python_tools/ruff" "$@" "$source_directory"
}

for source_directory in "$@"; do
    run_ruff "$source_directory"

    if ! python_files_in "$source_directory" \
        | xargs "$python_tools/pylint" --disable=all \
        --enable="$pylint_rules"; then
        echo "checks: $source_directory breaks a pylint rule ruff" >&2
        echo "checks: does not have" >&2
        exit 1
    fi
done
