#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: linters in php (phpcs)"
echo "checks: write for the reader - code is read far more than written"

require_binary "$php_tools/phpcs" phpcs

generated_rules=$(mktemp -d)
trap 'rm -rf "$generated_rules"' EXIT
ignored_sniffs=$(whitelisted_rules_for phpcs | paste -sd, -)

packages=$(packages_of "$@")

for package in $packages; do
    rules="$generated_rules/phpcs.xml"
    generated_configuration phpcs "$package" > "$rules"
    folders=$(package_folders "$package" "$@")
    root_files=$(package_root_files "$package")

    if ! "$php_tools/phpcs" -q --standard="$rules" \
        ${ignored_sniffs:+--exclude="$ignored_sniffs"} \
        $folders $root_files; then
        echo "checks: phpcs rejected $package - phpcbf fixes the" >&2
        echo "checks: layout, the rest needs a hand" >&2
        exit 1
    fi
done
