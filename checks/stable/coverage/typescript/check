#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: typescript coverage (the package's coverage script)"
echo "checks: test first - do not write a branch no test asked for"

for source_directory in "$@"; do
    package=$(package_of "$source_directory")
    require_node_modules "$package"

    if ! (cd "$package" && npm run --silent coverage); then
        echo "checks: $package is not covered - test every branch" >&2
        echo "checks: you wrote, or delete the branch no test" >&2
        echo "checks: asked for" >&2
        exit 1
    fi
done
