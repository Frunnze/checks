#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: strict typing in typescript (tsc)"
echo "checks: type it strictly - an illegal state must fail to compile"
echo "checks: never silence the checker - fix the type instead"

require_binary "$node_tools/tsc" typescript

silencers='@ts-ignore|@ts-expect-error|@ts-nocheck|eslint-disable'
silencers="$silencers|/\*[[:space:]]*eslint([[:space:]]|$)"
silencers="$silencers|^[[:space:]]*eslint[[:space:]]+[^[:space:]:]+:"
silenced=$(grep -rniE "$silencers" "$@" || true)

fail_on_findings "$silenced" \
    "the type checker is silenced here - fix the type:"

type_check_strictest() {
    "$node_tools/tsc" --noEmit -p "$1/tsconfig.json" \
        --strict \
        --noImplicitAny \
        --noImplicitThis \
        --strictNullChecks \
        --strictFunctionTypes \
        --strictBindCallApply \
        --strictPropertyInitialization \
        --strictBuiltinIteratorReturn \
        --useUnknownInCatchVariables \
        --noUncheckedIndexedAccess \
        --exactOptionalPropertyTypes \
        --noImplicitOverride \
        --noImplicitReturns \
        --noFallthroughCasesInSwitch \
        --noPropertyAccessFromIndexSignature \
        --noUnusedLocals \
        --noUnusedParameters \
        --allowUnreachableCode false \
        --allowUnusedLabels false \
        --noUncheckedSideEffectImports
}

for source_directory in "$@"; do
    package=$(package_of "$source_directory")
    require_node_modules "$package"

    if ! type_check_strictest "$package"; then
        echo "checks: $package does not type-check" >&2
        exit 1
    fi
done
