#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "pre-commit: strict typing in typescript (tsc)"
echo "pre-commit: type it strictly - an illegal state must fail to compile"
echo "pre-commit: never silence the checker - fix the type instead"

require_binary "$node_tools/tsc" typescript

silencers='@ts-ignore|@ts-expect-error|@ts-nocheck|eslint-disable'
silenced=$(grep -rnE "$silencers" $(sources_and_tests "$@") || true)

fail_on_findings "$silenced" \
    "the type checker is silenced here - fix the type:"

for source_directory in "$@"; do
    package=$(package_of "$source_directory")
    require_node_modules "$package"

    if ! "$node_tools/tsc" --noEmit -p "$package/tsconfig.json"; then
        echo "pre-commit: $package does not type-check" >&2
        exit 1
    fi
done
