#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: unraised exceptions in python (an error built must be raised)"
echo "checks: a guard that builds its error without raise stops nothing"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/unraised_exceptions.py")
unraised=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$unraised" \
    "these exceptions are built and thrown away, so the code goes on as" \
    "if nothing failed - raise them:"
