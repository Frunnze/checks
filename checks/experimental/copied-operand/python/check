#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: copied operands in python (no a - a, no v[0], v[1], v[1])"
echo "checks: a copied line with one name left unchanged computes garbage"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/copied_operands.py")
copied=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$copied" \
    "these operands look copied without the edit they needed - fix the" \
    "repeated name or index:"
