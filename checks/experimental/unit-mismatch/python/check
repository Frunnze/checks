#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: unit mismatch in python (no ms mixed with s, no B with MB)"
echo "checks: a value named in one unit must not meet a place in another"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/unit_mismatches.py")
mismatches=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$mismatches" \
    "these values meet a place that counts in another unit - convert" \
    "them (x_ms / 1000) or rename what is misnamed:"
