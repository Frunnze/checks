#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: mac comparisons in python (verify an HMAC in constant time)"
echo "checks: == stops at the first wrong byte, so timing reveals the MAC"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/mac_comparisons.py")
comparisons=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$comparisons" \
    "these HMACs are checked with == - compare them with" \
    "hmac.compare_digest(expected, received):"
