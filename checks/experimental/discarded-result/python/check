#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: discarded results in python (no text.strip() left unassigned)"
echo "checks: a call that returns a new value changes nothing when dropped"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/discarded_results.py")
discarded=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$discarded" \
    "these results are thrown away and the original stays unchanged -" \
    "assign them (text = text.strip()) or drop the call:"
