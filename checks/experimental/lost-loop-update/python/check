#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: lost loop updates in python (no result replaced on every pass)"
echo "checks: a loop that replaces what it collects keeps only the last pass"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/lost_loop_updates.py")
lost=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$lost" \
    "these loops throw away the work of earlier passes - add to the" \
    "collected value instead of replacing or rebuilding it:"
