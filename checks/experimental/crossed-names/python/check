#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: crossed names in python (no mobile=styles.tablet.gap)"
echo "checks: an item among parallel items must read its own value"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/crossed_names.py")
crossed=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$crossed" \
    "these items take the value written for a neighbour - point each" \
    "at its own value or rename it:"
