#!/bin/sh
set -e
. "$toolkit/tools.sh"

joined_words='[A-Za-z0-9_]*[A-Za-z0-9]_(and|or)_'
joined_function="(async[[:space:]]+)?def[[:space:]]+$joined_words"
joined_class='class[[:space:]]+[A-Za-z0-9_]*(And|Or)[A-Z]'
joined_definition="^[[:space:]]*($joined_function|$joined_class)"

echo "checks: definition names in python (one responsibility per name)"
echo "checks: follow SRP - split a name that says 'and'/'or'"

joined_names=$(python_files_in "$@" | while IFS= read -r source_file; do
    grep -anHE "$joined_definition" "$source_file" || true
done | reportable_findings)

fail_on_findings "$joined_names" \
    "these names join two responsibilities - split them:"
