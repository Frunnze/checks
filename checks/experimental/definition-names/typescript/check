#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "pre-commit: definition names in typescript (one responsibility per"
echo "pre-commit: name)"
echo "pre-commit: follow SRP - split a name that says 'And'/'Or'"

require_binary "$node_binary" node
require_binary "$typescript_module" typescript

findings=$(typescript_files_in "$@" \
    | "$node_binary" "$(dirname "$0")/joined_names.js" "$typescript_module")
joined_names=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$joined_names" \
    "these names join two responsibilities - split them:"
