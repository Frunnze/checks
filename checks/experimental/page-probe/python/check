#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: page probe in python (fetch limit + 1 to test len > limit)"
echo "checks: a page of limit rows never holds more - the next is lost"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/page_probes.py")
probes=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$probes" \
    "these lengths are tested against the size they were fetched with -" \
    "fetch one more (limit + 1) or compare with a smaller bound:"
