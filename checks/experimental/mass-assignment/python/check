#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: mass assignment in python (no setattr of every key it was sent)"
echo "checks: copying a whole mapping lets the caller set any field"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/mass_assignments.py")
assignments=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$assignments" \
    "these loops copy every key onto an object - check each key against" \
    "the fields a caller may change:"
