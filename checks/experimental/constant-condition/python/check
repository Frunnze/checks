#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: constant conditions in python (no x != a or x != b)"
echo "checks: a guard that is always true or always false guards nothing"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/constant_conditions.py")
conditions=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$conditions" \
    "these conditions never change - the and/or is likely swapped:"
