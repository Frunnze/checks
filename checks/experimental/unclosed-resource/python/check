#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: unclosed resources in python (every client and file closed)"
echo "checks: an unclosed client leaks sockets until the process runs out"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/unclosed_resources.py")
resources=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$resources" \
    "these resources are opened and never released - open them in a" \
    "with block, or close them in finally:"
