#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: property tests in python (one per definition)"
echo "checks: design by contract - assert the guarantee, not the behaviour"

findings=$(for source_directory in "$@"; do
    python_files_in $(sources_and_tests "$source_directory") \
        | "$toolkit_python" "$(dirname "$0")/property_test_coverage.py" \
        "$source_directory"
done)
untested=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$untested" \
    "nothing states a property about these - give each a hypothesis" \
    "test named test_<function>_property_<what it guarantees> that" \
    "asserts a contract guarantee over generated input:"
