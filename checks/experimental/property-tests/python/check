#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: property tests in python (four per definition)"
echo "checks: design by contract - assert the guarantee, not the behaviour"

tested_directories=$(tested_sources "$@")

findings=$(for source_directory in $tested_directories; do
    python_files_in $(sources_and_tests "$source_directory") \
        | "$toolkit_python" "$(dirname "$0")/property_test_coverage.py" \
        "$source_directory"
done)
untested=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$untested" \
    "too few properties are stated about these - give each four" \
    "hypothesis tests named test_<function>_property_<what it guarantees>" \
    "that each assert a contract guarantee over generated input:"
