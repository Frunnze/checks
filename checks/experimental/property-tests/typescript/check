#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: property tests in typescript (four per definition)"
echo "checks: design by contract - assert the guarantee, not the behaviour"

require_binary "$node_binary" node
require_binary "$typescript_module" typescript

tested_directories=$(tested_sources "$@")

findings=$(for source_directory in $tested_directories; do
    typescript_files_in $(sources_and_tests "$source_directory") \
        | "$node_binary" "$(dirname "$0")/property_test_coverage.js" \
        "$typescript_module" "$source_directory"
done)
untested=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$untested" \
    "too few properties are stated about these - give each four" \
    "fast-check tests titled \"<function> property <what it guarantees>\"" \
    "that each assert a contract guarantee over generated input:"
