#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "pre-commit: nested definitions in python (no def inside a def)"
echo "pre-commit: keep it testable - nothing can reach a def hidden in a def"

nested_definitions=$(python_files_in $(sources_and_tests "$@") \
    | "$toolkit_python" "$(dirname "$0")/nested_definitions.py" \
    | reportable_findings)

fail_on_findings "$nested_definitions" \
    "these definitions are nested - lift them out:"
