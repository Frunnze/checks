#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: permissive defaults in python (unset must mean safe)"
echo "checks: a missing env var must not turn debug on or verification off"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/permissive_defaults.py")
defaults=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$defaults" \
    "these settings are unsafe whenever the variable is missing - default" \
    "to the safe value, or fail when it is unset:"
