#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: open/closed in python (no growing closed dispatches)"
echo "checks: follow OCP - extend behaviour without editing its policy"

python_files=$(python_files_in "$@")
source_directories=$(setting "checks.$check_name.source_directories")
protocol_files=$(
    python_files_in $source_directories
    typescript_files_in $source_directories
)
dispatches=$(
    printf '%s\n' "$python_files" | "$toolkit_python" \
        "$(dirname "$0")/variant_dispatches.py"
    printf '%s\n' "$protocol_files" | "$toolkit_python" \
        "$(dirname "$0")/protocol_strings.py" python
)

fail_on_findings "$(printf '%s\n' "$dispatches" | reportable_findings)" \
    "these open/closed risks were detected:" \
    "follow OCP - replace the branch with an injected strategy/handler," \
    "polymorphism, or a registry wired at the composition boundary"
