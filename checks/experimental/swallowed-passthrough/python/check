#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: swallowed passthrough in python (no sibling eats a re-raise)"
echo "checks: an error a sibling lets through must not vanish here"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/swallowed_passthroughs.py")
swallows=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$swallows" \
    "these broad handlers swallow errors that sibling code re-raises -" \
    "let them through the same way (except X: raise) before the handler:"
