#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: textual number comparisons in python (no '10' < '9')"
echo "checks: numbers and versions written as text do not order as numbers"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/textual_number_comparisons.py")
comparisons=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$comparisons" \
    "these comparisons order numbers as text - convert both sides to" \
    "int, float or a parsed version first:"
