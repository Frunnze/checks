#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: float drift in python (no 0.1 steps on a compared total)"
echo "checks: summing 0.1 in a float drifts, so its limit is off by a step"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/float_drift.py")
drifting=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$drifting" \
    "these totals drift away from the limit they are compared with -" \
    "count in whole units (cents, steps) or use decimal.Decimal:"
