#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: unbounded fetches in python (an ordered query keeping one row"
echo "checks: needs LIMIT 1, or the database sends every row)"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/unbounded_fetches.py")
fetches=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$fetches" \
    "these queries send every matching row to keep one - add LIMIT 1:"
