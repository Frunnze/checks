findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/uneven_twins.py")
uneven=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$uneven" \
    "these lines lack the abs() or +/- 1 their twin has - add it here" \
    "or drop it from the twin:"
