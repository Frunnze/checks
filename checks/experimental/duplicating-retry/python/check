#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: duplicating retries in python (no write retried after a timeout)"
echo "checks: a timed-out POST may have run, so a retry can charge twice"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/duplicating_retries.py")
retries=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$retries" \
    "these loops repeat a write that may already have happened - send an" \
    "idempotency key, or retry only errors raised before the request left:"
