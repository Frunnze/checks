#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "pre-commit: single responsibility in python (two or more external"
echo "pre-commit: entities blocks)"
echo "pre-commit: Agent: first identify whether each finding is a real SRP violation."
echo "pre-commit: Split only the real violations. If a finding is not one, never refactor it - whitelist it: add the exact finding and a reason to [checks.single-responsibility] whitelist in checks.toml"

reviewed_findings=$(mktemp)
trap 'rm -f "$reviewed_findings"' EXIT
whitelist_entries > "$reviewed_findings"

"$toolkit_python" "$(dirname "$0")/srp_check.py" \
    --whitelist "$reviewed_findings" "$@"
