#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: unnormalized guards in python (no 'not raw' after raw.strip())"
echo "checks: a guard must test the normalized value the code goes on to use"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/unnormalized_guards.py")
guards=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$guards" \
    "these guards test the raw value while the code uses its normalized" \
    "copy - test the normalized name instead:"
