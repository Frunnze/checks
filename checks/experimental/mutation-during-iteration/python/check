#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: mutation during iteration in python (no remove inside its loop)"
echo "checks: a for loop must not resize the collection it walks over"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/iteration_mutations.py")
mutations=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$mutations" \
    "these loops resize the collection they iterate - loop over a copy" \
    "(for item in list(items)) or build a new collection:"
