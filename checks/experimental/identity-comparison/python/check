#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: identity comparison in python (no is with a str or int value)"
echo "checks: is asks for the same object, equal values are often not"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/identity_comparisons.py")
comparisons=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$comparisons" \
    "these comparisons test identity where they mean equality - use ==" \
    "or != (keep is for None, True, False and object() sentinels):"
