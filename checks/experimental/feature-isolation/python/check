#!/bin/sh
set -e
. "$toolkit/tools.sh"

. "$(dirname "$0")/../layout.sh"

echo "checks: feature isolation in python (siblings meet only in"
echo "checks: shared)"

require_feature_layout features "$@"

findings=$(for source_directory in "$@"; do
    python_files_in "$source_directory" \
        | "$toolkit_python" "$(dirname "$0")/feature_imports.py" \
        "$source_directory"
done)
crossings=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$crossings" \
    "these features reach into a sibling - move what they share into" \
    "shared/ and depend on that:"

echo "checks: shared ownership (two features or it is not shared)"

findings=$(for source_directory in "$@"; do
    python_files_in "$source_directory" \
        | "$toolkit_python" "$(dirname "$0")/shared_usage.py" \
        "$source_directory"
done)
lonely=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$lonely" \
    "shared/ is for what several features need - move each of these" \
    "into the one feature that uses it:"
