#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: caches across users in python (no request data in lru_cache)"
echo "checks: a cache keyed by arguments serves one user's data to another"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/caches_across_users.py")
cached=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$cached" \
    "these cached functions read the current user or request - pass it in" \
    "as an argument so it becomes part of the cache key:"
