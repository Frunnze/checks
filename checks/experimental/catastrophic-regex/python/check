#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: catastrophic regexes in python (no (a+)+ style patterns)"
echo "checks: one crafted input makes such a pattern backtrack for minutes"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/catastrophic_regexes.py")
regexes=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$regexes" \
    "these patterns backtrack exponentially on a long non-matching" \
    "input - make the inner and outer repeats unable to share text:"
