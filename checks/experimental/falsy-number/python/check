#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: falsy numbers in python (a None check must not catch 0)"
echo "checks: 'not x or x < y' sends x = 0 down the None branch"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/falsy_numbers.py")
falsy=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$falsy" \
    "these tests mean 'is None' but also catch 0 - write 'x is None'" \
    "or 'x is not None':"
