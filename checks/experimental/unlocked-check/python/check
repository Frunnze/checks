#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: unlocked check in python (check and set under the lock)"
echo "checks: an attribute the class locks must not be checked then set bare"

findings=$(python_files_in "$@" \
    | "$toolkit_python" "$(dirname "$0")/unlocked_checks.py")
unlocked=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$unlocked" \
    "these attributes are checked then set outside the lock - move the" \
    "check and the set into the locked block:"
